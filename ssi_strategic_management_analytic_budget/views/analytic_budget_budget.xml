<odoo>
<record id="analytic_budget_budget_view_form" model="ir.ui.view">
    <field name="name">analytic_budget.budget - form (strategy initiative)</field>
    <field name="model">analytic_budget.budget</field>
    <field
            name="inherit_id"
            ref="ssi_analytic_budget.analytic_budget_budget_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//page[@name='lines']" position="after">
                <page
                        name="strategy_initiative"
                        string="Strategic Initiatives"
                        groups="ssi_strategic_management.strategy_initiative_viewer_group"
                    >
                    <field
                            name="strategy_initiative_ids"
                            colspan="4"
                            nolabel="1"
                            readonly="1"
                        >
                        <tree>
                            <field name="name" />
                            <field name="plan_id" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="progress" widget="progressbar" />
                            <field name="health" />
                            <field name="state" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>
</odoo>
