<odoo>
<record id="strategy_plan_policy_template" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_strategy_plan" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','strategy_plan'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- confirm -->
<record
        id="strategy_plan_policy_template_detail_confirm"
        model="policy.template_detail"
    >
    <field name="template_id" ref="strategy_plan_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_plan'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_plan'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('strategy_plan_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- approve -->
<record
        id="strategy_plan_policy_template_detail_approve"
        model="policy.template_detail"
    >
    <field name="template_id" ref="strategy_plan_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_plan'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_plan'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- reject -->
<record id="strategy_plan_policy_template_detail_reject" model="policy.template_detail">
    <field name="template_id" ref="strategy_plan_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_plan'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_plan'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- restart approval -->
<record
        id="strategy_plan_policy_template_detail_restart_approval"
        model="policy.template_detail"
    >
    <field name="template_id" ref="strategy_plan_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_plan'),('name','=','restart_approval_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_plan'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('strategy_plan_validator_group')])]" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if not document.approval_template_id:
    result = True</field>
</record>

