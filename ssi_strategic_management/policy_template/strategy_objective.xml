<odoo>
<record id="strategy_objective_policy_template" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_strategy_objective" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','strategy_objective'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- open -->
<record
        id="strategy_objective_policy_template_detail_open"
        model="policy.template_detail"
    >
    <field name="template_id" ref="strategy_objective_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_objective'),('name','=','open_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_objective'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('strategy_objective_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- done -->
<record
        id="strategy_objective_policy_template_detail_done"
        model="policy.template_detail"
    >
    <field name="template_id" ref="strategy_objective_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_objective'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_objective'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('strategy_objective_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- cancel -->
<record
        id="strategy_objective_policy_template_detail_cancel"
        model="policy.template_detail"
    >
    <field name="template_id" ref="strategy_objective_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','strategy_objective'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','strategy_objective'),('value','in',['draft','open'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('strategy_objective_validator_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>

