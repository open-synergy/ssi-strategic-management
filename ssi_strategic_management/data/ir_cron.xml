<record id="strategy_kpi_target_cron_monthly" model="ir.cron">
    <field name="name">Strategy KPI: compute monthly realization</field>
    <field name="model_id" ref="model_strategy_kpi_target" />
    <field name="state">code</field>
    <field name="code">model._cron_compute_realization("monthly")</field>
    <field name="user_id" ref="base.user_root" />
