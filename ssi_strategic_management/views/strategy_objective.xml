<odoo>
<record id="strategy_objective_view_search" model="ir.ui.view">
    <field name="name">strategy_objective - search</field>
    <field name="model">strategy_objective</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="plan_id" />
                <field name="perspective_id" />
                <field name="department_id" />
                <field name="employee_id" />
                <field name="owner_id" />
                <field name="parent_id" />
            </xpath>
            <xpath expr="//filter[@name='grp_responsible']" position="after">
                <filter
                        name="grp_plan_id"
                        string="Plan"
                        context="{'group_by':'plan_id'}"
                    />
                <filter
                        name="grp_perspective_id"
                        string="Perspective"
                        context="{'group_by':'perspective_id'}"
                    />
                <filter
                        name="grp_department_id"
                        string="Department"
                        context="{'group_by':'department_id'}"
                    />
                <filter
                        name="grp_parent_id"
                        string="Parent Objective"
                        context="{'group_by':'parent_id'}"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_objective_view_tree" model="ir.ui.view">
    <field name="name">strategy_objective - tree</field>
    <field name="model">strategy_objective</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="plan_id" />
                <field name="perspective_id" />
                <field name="department_id" />
                <field name="employee_id" />
                <field name="parent_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_objective_view_form" model="ir.ui.view">
    <field name="name">strategy_objective - form</field>
    <field name="model">strategy_objective</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="plan_id" />
                <field name="perspective_id" />
                <field name="department_id" />
                <field name="employee_id" />
                <field name="owner_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="objective_type" />
                <field name="parent_id" />
                <field name="cascade_method" />
                <field name="contribute_to_parent" />
                <field name="weight" />
            </xpath>
            <xpath expr="//page[@name='note']" position="before">
                <page name="kpi" string="KPIs">
                    <field name="kpi_ids" colspan="4" nolabel="1">
                        <tree>
                            <field name="name" />
                            <field name="measure_id" />
                            <field name="weight" />
                            <field name="target" />
                            <field name="is_key_result" />
                            <field name="score" />
                        </tree>
                        <form>
                            <group name="kpi_group_1" colspan="4" col="2">
            <field name="measure_id" />
            <field name="name" />
            <field name="weight" />
            <field name="baseline" />
            <field name="target" />
            <field name="uom_label" />
            <field name="polarity" />
            <field name="aggregation" />
            <field name="score_method" />
            <field name="score_min" />
            <field name="score_max" />
            <field name="is_key_result" />
            <field
                                        name="key_result_type"
                                        attrs="{'required': [('is_key_result', '=', True)], 'invisible': [('is_key_result', '=', False)]}"
                                    />
            <field name="score" />
        </group>
        <notebook>
            <page name="targets" string="Targets">
                <field name="target_ids" colspan="4" nolabel="1">
                    <tree>
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="target" />
                        <field name="realization" />
                        <field name="score" />
                        <field name="final_score" />
                    </tree>
                    <form>
                        <field name="is_automatic" invisible="1" />
                        <div name="target_action">
                            <button
                                                        name="action_compute_realization"
                                                        type="object"
                                                        string="Compute"
                                                        class="oe_highlight"
                                                        attrs="{'invisible': ['|', ('id', '=', False), ('is_automatic', '=', False)]}"
                                                    />
                        </div>
                        <group name="target_group_1" colspan="4" col="2">
                            <field name="date_range_id" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="target" />
                            <field name="realization" />
                            <field name="score" />
                            <field name="final_score" />
                        </group>
                        <field name="measurement_ids" colspan="4" nolabel="1">
                            <tree editable="bottom">
                                <field name="mode" />
                                <field name="date" />
                                <field name="manual_value" />
                                <field name="automatic_value" />
                                <field name="override_automatic" />
                                <field name="dissenting_note" />
                                <field name="user_id" />
                                <field name="note" />
                            </tree>
                            <form>
                                <group name="measurement_group_1" colspan="4" col="2">
                                    <field name="mode" />
                                    <field name="date" />
                                    <field name="manual_value" />
                                    <field name="automatic_value" />
                                    <field name="override_automatic" />
                                    <field name="dissenting_note" />
                                    <field name="user_id" />
                                    <field name="note" />
                                </group>
                            </form>
                        </field>
                    </form>
                </field>
            </page>
            <page name="score_ranges" string="Score Ranges">
                <field name="score_range_ids" colspan="4" nolabel="1">
                    <tree editable="bottom">
                        <field name="min_value" />
                        <field name="max_value" />
                        <field name="score" />
                    </tree>
                    <form>
                        <group name="score_range_group_1" colspan="4" col="2">
                            <field name="min_value" />
                            <field name="max_value" />
                            <field name="score" />
                        </group>
                    </form>
                </field>
            </page>
        </notebook>
                        </form>
                    </field>
                </page>
                <page name="child" string="Child Objectives">
                    <field name="child_ids" colspan="4" nolabel="1">
                        <tree>
                            <field name="name" />
                            <field name="department_id" />
                            <field name="employee_id" />
                            <field name="cascade_method" />
                            <field name="contribute_to_parent" />
                            <field name="weight" />
                            <field name="state" />
                        </tree>
                        <form>
                            <group name="child_form_1" colspan="4" col="2">
                                <field name="name" />
                                <field name="department_id" />
                                <field name="employee_id" />
                                <field name="cascade_method" />
                                <field name="contribute_to_parent" />
                                <field name="weight" />
                                <field name="state" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="influence" string="Influences">
                    <field name="influence_ids" colspan="4" nolabel="1">
                        <tree>
                            <field name="name" />
                            <field name="plan_id" />
                            <field name="perspective_id" />
                            <field name="department_id" />
                            <field name="state" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_objective_action" model="ir.actions.act_window">
    <field name="name">Objectives</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">strategy_objective</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="strategy_objective_menu"
        name="Objectives"
        parent="menu_strategic_management_strategy"
        action="strategy_objective_action"
        groups="strategy_objective_viewer_group"
        sequence="20"
    />
</odoo>
