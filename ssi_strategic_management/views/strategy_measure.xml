<odoo>
<record id="strategy_measure_view_search" model="ir.ui.view">
    <field name="name">strategy_measure - search</field>
    <field name="model">strategy_measure</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="strategy_measure_view_tree" model="ir.ui.view">
    <field name="name">strategy_measure - tree</field>
    <field name="model">strategy_measure</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="polarity" />
                <field name="frequency" />
                <field name="indicator_type" />
                <field name="aggregation" />
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_measure_view_form" model="ir.ui.view">
    <field name="name">strategy_measure - form</field>
    <field name="model">strategy_measure</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="indicator" string="Indicator">
                    <group name="indicator_group_1" string="Indicator">
                        <field name="uom_label" />
                        <field name="polarity" />
                        <field name="frequency" />
                        <field name="indicator_type" />
                        <field name="aggregation" />
                    </group>
                </page>
                <page name="definition" string="Definition">
                    <group name="definition_group_1" string="Definition">
                        <field name="definition" />
                        <field name="data_source" />
                    </group>
                </page>
                <page name="scoring" string="Scoring">
                    <group name="scoring_group_1" string="Score Limits">
                        <field name="score_min" />
                        <field name="score_max" />
                    </group>
                    <field name="score_range_ids" colspan="4" nolabel="1">
                        <tree editable="bottom">
                            <field name="min_value" />
                            <field name="max_value" />
                            <field name="score" />
                        </tree>
                        <form>
                            <group name="score_range_group_1" colspan="4" col="2">
                                <field name="min_value" />
                                <field name="max_value" />
                                <field name="score" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_measure_action" model="ir.actions.act_window">
    <field name="name">Measure Library</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">strategy_measure</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="strategy_measure_menu"
        name="Measure Library"
        parent="menu_strategic_management_configuration"
        action="strategy_measure_action"
        groups="strategy_measure_group"
        sequence="20"
    />
</odoo>
