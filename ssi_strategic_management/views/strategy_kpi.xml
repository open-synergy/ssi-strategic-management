<odoo>
<record id="strategy_kpi_view_search" model="ir.ui.view">
    <field name="name">strategy_kpi - search</field>
    <field name="model">strategy_kpi</field>
    <field name="arch" type="xml">
        <search>
            <field name="name" />
            <field name="objective_id" />
            <field name="measure_id" />
            <filter
                    name="dom_key_result"
                    string="Key Results"
                    domain="[('is_key_result', '=', True)]"
                />
            <group name="group_by" string="Group By">
                <filter
                        name="grp_objective_id"
                        string="Objective"
                        context="{'group_by':'objective_id'}"
                    />
                <filter
                        name="grp_measure_id"
                        string="Measure"
                        context="{'group_by':'measure_id'}"
                    />
            </group>
        </search>
    </field>
</record>

<record id="strategy_kpi_view_tree" model="ir.ui.view">
    <field name="name">strategy_kpi - tree</field>
    <field name="model">strategy_kpi</field>
    <field name="arch" type="xml">
        <tree create="0">
            <field name="objective_id" />
            <field name="name" />
            <field name="measure_id" />
            <field name="weight" />
            <field name="target" />
            <field name="is_key_result" />
            <field name="score" />
        </tree>
    </field>
</record>

<record id="strategy_kpi_view_form" model="ir.ui.view">
    <field name="name">strategy_kpi - form</field>
    <field name="model">strategy_kpi</field>
    <field name="arch" type="xml">
        <form create="0">
            <sheet>
                <group name="kpi_group_1" colspan="4" col="2">
            <field name="objective_id" readonly="1" />
            <field name="measure_id" />
            <field name="name" />
            <field name="weight" />
            <field name="baseline" />
            <field name="target" />
            <field name="uom_label" />
            <field name="polarity" />
            <field name="aggregation" />
            <field name="score_method" />
            <field name="score_min" />
            <field name="score_max" />
            <field name="realization_method" />
            <field name="parent_kpi_id" />
            <field name="is_key_result" />
            <field
                            name="key_result_type"
                            attrs="{'required': [('is_key_result', '=', True)], 'invisible': [('is_key_result', '=', False)]}"
                        />
            <field name="score" />
        </group>
        <notebook>
            <page name="targets" string="Targets">
                <field name="target_ids" colspan="4" nolabel="1">
                    <tree>
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="target" />
                        <field name="realization" />
                        <field name="score" />
                        <field name="final_score" />
                    </tree>
                    <form>
                        <field name="is_automatic" invisible="1" />
                        <div name="target_action">
                            <button
                                            name="action_compute_realization"
                                            type="object"
                                            string="Compute"
                                            class="oe_highlight"
                                            attrs="{'invisible': ['|', ('id', '=', False), ('is_automatic', '=', False)]}"
                                        />
                        </div>
                        <group name="target_group_1" colspan="4" col="2">
                            <field name="date_range_id" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="target" />
                            <field name="realization" />
                            <field name="score" />
                            <field name="final_score" />
                        </group>
                        <field name="measurement_ids" colspan="4" nolabel="1">
                            <tree editable="bottom">
                                <field name="mode" />
                                <field name="date" />
                                <field name="manual_value" />
                                <field name="automatic_value" />
                                <field name="override_automatic" />
                                <field name="dissenting_note" />
                                <field name="user_id" />
                                <field name="note" />
                            </tree>
                            <form>
                                <group name="measurement_group_1" colspan="4" col="2">
                                    <field name="mode" />
                                    <field name="date" />
                                    <field name="manual_value" />
                                    <field name="automatic_value" />
                                    <field name="override_automatic" />
                                    <field name="dissenting_note" />
                                    <field name="user_id" />
                                    <field name="note" />
                                </group>
                            </form>
                        </field>
                    </form>
                </field>
            </page>
            <page
                            name="python_code"
                            string="Python Code"
                            attrs="{'invisible': [('realization_method', '!=', 'python')]}"
                        >
                <field name="python_code" colspan="4" nolabel="1" />
            </page>
            <page name="child_kpis" string="Child KPIs">
                <field name="child_kpi_ids" colspan="4" nolabel="1" readonly="1">
                    <tree>
                        <field name="objective_id" />
                        <field name="name" />
                        <field name="weight" />
                        <field name="score" />
                    </tree>
                    <form>
                        <group name="child_kpi_group_1" colspan="4" col="2">
                            <field name="objective_id" />
                            <field name="name" />
                            <field name="weight" />
                            <field name="score" />
                        </group>
                    </form>
                </field>
            </page>
            <page name="score_ranges" string="Score Ranges">
                <field name="score_range_ids" colspan="4" nolabel="1">
                    <tree editable="bottom">
                        <field name="min_value" />
                        <field name="max_value" />
                        <field name="score" />
                    </tree>
                    <form>
                        <group name="score_range_group_1" colspan="4" col="2">
                            <field name="min_value" />
                            <field name="max_value" />
                            <field name="score" />
                        </group>
                    </form>
                </field>
            </page>
        </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="strategy_kpi_action" model="ir.actions.act_window">
    <field name="name">KPIs</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">strategy_kpi</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="strategy_kpi_menu"
        name="KPIs"
        parent="menu_strategic_management_strategy"
        action="strategy_kpi_action"
        groups="strategy_objective_viewer_group"
        sequence="30"
    />
</odoo>
