<odoo>
<record id="strategy_perspective_view_search" model="ir.ui.view">
    <field name="name">strategy_perspective - search</field>
    <field name="model">strategy_perspective</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="strategy_perspective_view_tree" model="ir.ui.view">
    <field name="name">strategy_perspective - tree</field>
    <field name="model">strategy_perspective</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="before">
                <field name="sequence" widget="handle" />
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_perspective_view_form" model="ir.ui.view">
    <field name="name">strategy_perspective - form</field>
    <field name="model">strategy_perspective</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="sequence" />
                <field name="color" />
            </xpath>
        </data>
    </field>
</record>

<record id="strategy_perspective_action" model="ir.actions.act_window">
    <field name="name">Perspectives</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">strategy_perspective</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="strategy_perspective_menu"
        name="Perspectives"
        parent="menu_strategic_management_configuration"
        action="strategy_perspective_action"
        groups="strategy_perspective_group"
        sequence="10"
    />
</odoo>
